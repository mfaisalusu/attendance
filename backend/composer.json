{
    "name": "attendance/backend",
    "description": "Attendance App Backend - Native PHP Clean Architecture",
    "type": "project",
    "require": {
        "php": "^8.1",
        "phpmailer/phpmailer": "^6.9",
        "firebase/php-jwt": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "audit": {
            "abandoned": "ignore"
        }
    }
}
